---
import type { ModelDisplay } from '@opb/core';
import StatusBadge from '../../components/StatusBadge.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CHECKS_TABLE, COMPARE_TAB, MODELS_TABLE, RECORD_TABLE, pageTitle } from '../../lib/copy.ts';
import { loadSiteData } from '../../lib/data.ts';
import { judgingCriteriaHref } from '../../lib/paths.ts';

// 비교표 탭 (docs/UI_GUIDE.md "비교표 탭"). 칸의 값·배지·판정 기호·각주 기호는 core displayModel 그대로,
// 행 순서는 loadSiteData 순서(출시일 최신순)다. 점수 합계·순위·강조 표시는 하지 않는다
const { models } = await loadSiteData();
const displays = models.map((m) => m.display);

const columnKeys = <T extends object>(columns: T) => Object.keys(columns) as (keyof T)[];
const MODEL_COLUMNS = columnKeys(MODELS_TABLE.columns);
const RECORD_COLUMNS = columnKeys(RECORD_TABLE.columns);
type RecordColumn = (typeof RECORD_COLUMNS)[number];

/** 표 2 칸 옆의 각주 기호 (§ † ‡는 displayModel이 행마다 정한다) */
const footnoteMark = (d: ModelDisplay, col: RecordColumn) =>
  col === 'inputTokens'
    ? d.inputTokensMark
    : col === 'outputTokens'
      ? d.outputTokensMark
      : col === 'reasoningTokens'
        ? d.reasoningTokensMark
        : '';

/** 표 1에서 Mono로 쓰는 칸 (날짜·크기·버전) */
const MONO_MODEL_COLUMNS = new Set<string>(['releasedAt', 'fileSize', 'threeVersion']);

const HEADING_ID = { models: 'models-table-title', record: 'record-table-title', checks: 'checks-table-title' } as const;
---

<SiteLayout title={pageTitle(COMPARE_TAB.title)} current="compare">
  <section class="intro">
    <h1>{COMPARE_TAB.title}</h1>
    <p>{COMPARE_TAB.description}</p>
  </section>

  <section class="block">
    <h2 id={HEADING_ID.models}>{MODELS_TABLE.title}</h2>
    <div class="table-wrap" role="region" tabindex="0" aria-labelledby={HEADING_ID.models}>
      <table data-table="models" aria-labelledby={HEADING_ID.models}>
        <thead>
          <tr>{Object.values(MODELS_TABLE.columns).map((name) => <th scope="col">{name}</th>)}</tr>
        </thead>
        <tbody>
          {
            displays.map((d) => (
              <tr data-slug={d.slug}>
                {MODEL_COLUMNS.map((col) =>
                  col === 'displayName' ? (
                    <th scope="row" data-col={col}>
                      {d.displayName}
                    </th>
                  ) : col === 'status' ? (
                    <td data-col={col}>
                      <StatusBadge badge={d.status} size="table" />
                    </td>
                  ) : (
                    <td data-col={col} class:list={{ num: MONO_MODEL_COLUMNS.has(col) }}>
                      {d[col]}
                    </td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="block">
    <h2 id={HEADING_ID.record}>{RECORD_TABLE.title}</h2>
    <p class="notice" data-field="notice">{RECORD_TABLE.notice}</p>
    <div class="table-wrap" role="region" tabindex="0" aria-labelledby={HEADING_ID.record}>
      <table data-table="record" aria-labelledby={HEADING_ID.record}>
        <thead>
          <tr>{Object.values(RECORD_TABLE.columns).map((name) => <th scope="col">{name}</th>)}</tr>
        </thead>
        <tbody>
          {
            displays.map((d) => (
              <tr data-slug={d.slug}>
                {RECORD_COLUMNS.map((col) => {
                  if (col === 'displayName') {
                    return (
                      <th scope="row" data-col={col}>
                        {d.displayName}
                      </th>
                    );
                  }
                  const mark = footnoteMark(d, col);
                  return (
                    <td data-col={col} class="num">
                      {d[col]}
                      {mark && <sup>{mark}</sup>}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ul class="footnotes" data-field="footnotes">
      {
        RECORD_TABLE.footnotes.map((f) => (
          <li>
            <sup>{f.mark}</sup> {f.text}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block">
    <h2 id={HEADING_ID.checks}>{CHECKS_TABLE.title}</h2>
    <div class="table-wrap" role="region" tabindex="0" aria-labelledby={HEADING_ID.checks}>
      <table data-table="checks" aria-labelledby={HEADING_ID.checks}>
        <thead>
          <tr>{Object.values(CHECKS_TABLE.columns).map((name) => <th scope="col">{name}</th>)}</tr>
        </thead>
        <tbody>
          {
            displays.map((d) => (
              <tr data-slug={d.slug}>
                <th scope="row" data-col="displayName">
                  {d.displayName}
                </th>
                {d.requirements.map((r) => (
                  <td class="mark" data-col={r.key} data-mark={r.mark ?? 'none'}>
                    {r.text}
                  </td>
                ))}
                <td data-col="requestCheck">{d.requestCheck}</td>
                <td data-col="errorCount" class="num">
                  {d.errorCount}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="legend" data-field="legend">
      {CHECKS_TABLE.legend.map((line) => <span>{line}</span>)}
      <a href={judgingCriteriaHref()}>{CHECKS_TABLE.criteriaLink}</a>
    </div>
  </section>
</SiteLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .intro p {
    margin: 0;
    max-width: 720px;
    color: var(--text-body);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }

  /* 비용 안내 박스 */
  .notice {
    margin: 0;
    padding: 12px 16px;
    border-radius: var(--radius-box);
    background: var(--notice-bg);
    color: var(--notice-text);
    font-size: 14px;
  }

  /* ───────── 표 (좁으면 가로 스크롤, 열을 숨기지 않는다) ───────── */

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--divider);
    font-size: 14px;
    text-align: left;
    vertical-align: middle;
  }

  /* 마지막 행 아래는 컨테이너 테두리가 맡는다 */
  tbody tr:last-child > * {
    border-bottom: 0;
  }

  thead th {
    background: var(--surface-muted);
    color: var(--text-body);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
  }

  /* 모델명 칸 */
  tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }

  /* 판정 칸: ✓ 충족 · △ 부분 충족 · ✗ 미충족, 판정 전 · —는 흐리게 */
  .mark {
    white-space: nowrap;
  }

  .mark[data-mark='none'] {
    color: var(--text-muted);
  }

  /* 각주 기호 († ‡ §) */
  sup {
    margin-left: 2px;
    line-height: 0;
    color: var(--footnote-mark);
  }

  .footnotes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footnotes sup {
    margin-left: 0;
  }

  /* 표 3 아래 범례 줄과 판정 기준 링크 */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
    color: var(--text-body);
  }
</style>
