---
import { RESULT_IFRAME_SANDBOX, STATUS_LEGEND, STATUS_TONE } from '@opb/core';
import StatusBadge from '../components/StatusBadge.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  MODEL_LIST,
  RECORD_CARD,
  REQUIREMENTS_CARD_TITLE,
  RESPONSE_CARD_TITLE,
  RESPONSE_LOAD_FAILED,
  RESULTS_TAB,
  RUN_ACTIONS,
  modelListMeta,
  modelOptionLabel,
  pageTitle,
  resultsChips,
} from '../lib/copy.ts';
import { loadSiteData } from '../lib/data.ts';
import { commitHashParts } from '../lib/regeneration-line.ts';
import { RECORD_KEYS, initialSelection, resultView, scriptJson } from '../lib/results-view.ts';

// 결과 탭(첫 화면, docs/UI_GUIDE.md "결과 탭"). 첫 선택 모델은 빌드 때 HTML로 그려서 스크립트 전에도 보인다 (ADR-025)
// 휴대폰(폭 < 768px)에서는 같은 자리의 <select>로 모델을 고른다. 버튼 목록과 선택기는 둘 다 HTML에 두고 CSS로 하나만 보인다
// 버린 결과물이 있는 모델은 실행 카드 위에 재생성 안내 박스를 보인다(ADR-032). 박스는 한 벌이고 없는 모델이면 hidden이다
const { models } = await loadSiteData();
const views = models.map((m) => resultView(m.display));
const selected = initialSelection(models.map((m) => m.display));
const view = views.find((v) => v.slug === selected?.slug);
---

<SiteLayout title={pageTitle()} current="results">
  <section class="intro">
    <h1>{RESULTS_TAB.title}</h1>
    <p>
      <span class="wide-only" data-screen="wide">{RESULTS_TAB.description.wide}</span>
      <span class="narrow-only" data-screen="narrow">{RESULTS_TAB.description.narrow}</span>
    </p>
    <ul class="chips">
      {resultsChips(models.length).map((chip) => <li>{chip}</li>)}
    </ul>
  </section>

  {
    view && (
      <div class="columns" data-results-tab>
        <aside class="models" aria-labelledby="models-title">
          <div class="list">
            <div class="list-head">
              <h2 id="models-title">{MODEL_LIST.title}</h2>
              <label for="model-select">{MODEL_LIST.title}</label>
              <span>{MODEL_LIST.sortNote}</span>
            </div>
            <select id="model-select" class="model-select" data-field="model-select" autocomplete="off">
              {models.map(({ display: d }) => (
                <option value={d.slug} selected={d.slug === view.slug}>
                  {modelOptionLabel(d.displayName, d.status.label)}
                </option>
              ))}
            </select>
            <ul class="model-list">
              {models.map(({ display: d }) => (
                <li>
                  <button type="button" class="model" data-slug={d.slug} aria-pressed={d.slug === view.slug ? 'true' : 'false'}>
                    <span class="model-main">
                      <span class="model-name">{d.displayName}</span>
                      <span class="model-meta">{modelListMeta(d.company, d.generator)}</span>
                    </span>
                    <span class="model-side">
                      <span class="model-date">{d.releasedAt}</span>
                      <StatusBadge badge={d.status} />
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <div class="legend" data-field="legend">
            <span class="legend-title">{MODEL_LIST.legendTitle}</span>
            <ul>
              {STATUS_LEGEND.map((label) => (
                <li>
                  <StatusBadge badge={{ label, tone: STATUS_TONE[label] }} />
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <div class="result">
          <div class="regeneration" data-field="regeneration" hidden={view.regeneration === null}>
            <p class="regeneration-title" data-field="regeneration-title">{view.regeneration?.title}</p>
            <ul class="regeneration-lines" data-field="regeneration-lines">
              {view.regeneration?.lines.map((line) => (
                <li>{commitHashParts(line).map((part) => (part.hash ? <code>{part.text}</code> : part.text))}</li>
              ))}
            </ul>
          </div>

          <section class="card run" aria-labelledby="run-name">
            <div class="run-head">
              <div class="run-title">
                <h2 id="run-name" data-field="name">{view.displayName}</h2>
                <span data-field="meta">{view.runMeta}</span>
              </div>
              <div class="run-actions" data-field="actions" hidden={view.output === null}>
                <button type="button" class="small-button" data-action="restart">{RUN_ACTIONS.restart}</button>
                <a class="small-button" data-action="open" href={view.output?.viewHref} target="_blank" rel="noopener">
                  {RUN_ACTIONS.openInNewWindow}
                </a>
              </div>
            </div>
            <div class="viewer" data-field="viewer">
              {view.output && <iframe sandbox={RESULT_IFRAME_SANDBOX} src={view.output.src} title={view.output.frameTitle} />}
              <div class="missing" data-field="missing" hidden={view.missing === null}>
                <p data-field="reason">{view.missing?.reason}</p>
              </div>
            </div>
          </section>

          <section class="card response" data-field="response" aria-labelledby="response-title" hidden={!view.missing?.responseTextSrc}>
            <h3 id="response-title">{RESPONSE_CARD_TITLE}</h3>
            <pre data-field="response-text" tabindex="0" />
            <p class="response-error" data-field="response-error" hidden>{RESPONSE_LOAD_FAILED}</p>
          </section>

          <div class="cards">
            <section class="card" aria-labelledby="requirements-title">
              <h3 id="requirements-title">{REQUIREMENTS_CARD_TITLE}</h3>
              <dl class="rows" data-field="requirements">
                {view.requirements.map((r) => (
                  <div class="row">
                    <dt>{r.label}</dt>
                    <dd class="mark" data-req={r.key} data-mark={r.mark ?? 'none'}>
                      {r.text}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="note" data-field="note" hidden={view.note === null}>{view.note}</p>
            </section>
            <section class="card" aria-labelledby="record-title">
              <h3 id="record-title">{RECORD_CARD.title}</h3>
              <dl class="rows" data-field="record">
                {RECORD_KEYS.map((key) => (
                  <div class="row">
                    <dt>{RECORD_CARD.rows[key]}</dt>
                    <dd class="value" data-record={key}>
                      {view.record[key]}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          </div>
        </div>

        <script is:inline type="application/json" id="result-views" set:html={scriptJson(views)} />
      </div>
    )
  }
</SiteLayout>

<script>
  import { setupResultsTab } from '../scripts/results-tab.ts';

  setupResultsTab();
</script>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .intro p {
    margin: 0;
    max-width: 680px;
    color: var(--text-body);
  }

  /* 설명 두 문장 중 화면에 맞는 하나만 보인다 (숨은 쪽은 display: none이라 스크린리더도 읽지 않는다) */
  .narrow-only {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-strong);
  }

  .chips li {
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
  }

  /* ───────── 두 열: 왼쪽 목록, 오른쪽 결과 (좁으면 위아래로 쌓인다) ───────── */

  .columns {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px;
  }

  .models {
    flex: 1 1 280px;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .result {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ───────── 모델 목록 (휴대폰에서는 선택기) ───────── */

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .list-head h2,
  .list-head label {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  /* 휴대폰 선택기: 넓은 화면에서는 숨는다 */
  .list-head label,
  .model-select {
    display: none;
  }

  .model-select {
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-box);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }

  .list-head span {
    font-size: 12px;
    color: var(--text-muted);
  }

  .model-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .model {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-box);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .model:hover {
    border-color: var(--border-strong);
  }

  /* 테두리가 2px로 두꺼워진 만큼 안쪽 여백을 줄여 내용이 움직이지 않게 한다 */
  .model[aria-pressed='true'] {
    padding: 9px 13px;
    border: 2px solid var(--accent);
    background: var(--surface-selected);
  }

  .model-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .model-name {
    font-size: 15px;
    font-weight: 600;
  }

  .model-meta {
    font-size: 12px;
    color: var(--text-muted);
  }

  .model-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }

  .model-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .legend {
    margin-top: 8px;
    padding: 12px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-box);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legend-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-strong);
  }

  .legend ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ───────── 재생성 안내 박스 (실행 카드 위, 비용 안내와 같은 안내 박스 — 경고색이 아니다) ───────── */

  .regeneration {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border-radius: var(--radius-box);
    background: var(--notice-bg);
    color: var(--notice-text);
    font-size: 14px;
  }

  .regeneration-title {
    margin: 0;
    font-weight: 600;
  }

  .regeneration-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
  }

  /* 줄과 해시는 모델을 바꿀 때 스크립트가 다시 만든다 → 스코프 속성이 없어도 맞게 :global */
  .regeneration-lines :global(code) {
    font-family: var(--font-mono);
    font-size: inherit;
  }

  /* ───────── 카드 ───────── */

  .card {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  /* 실행 카드: 머리 줄 + 실행 영역 */
  .run {
    padding: 0;
    gap: 0;
    overflow: hidden;
  }

  .run-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 61px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--divider);
  }

  .run-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    min-width: 0;
  }

  .run-title h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .run-title span {
    font-size: 12px;
    color: var(--text-muted);
  }

  .run-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .small-button {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--accent);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;
  }

  .small-button:hover {
    color: var(--accent-hover);
    border-color: var(--accent);
  }

  .viewer {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--viewer-bg);
  }

  .viewer iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .missing {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
  }

  .missing p {
    margin: 0;
    max-width: 480px;
    color: var(--viewer-title);
    font-size: 16px;
    font-weight: 500;
  }

  /* 응답 원문 */
  .response pre {
    margin: 0;
    max-height: 480px;
    overflow: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-strong);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .response-error {
    margin: 0;
    font-size: 13px;
    color: var(--text-body);
  }

  /* 아래 카드 두 개: 요구사항 판정 · 생성 기록 */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
  }

  dt {
    color: var(--text);
  }

  dd {
    margin: 0;
    text-align: right;
  }

  .mark {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-strong);
    white-space: nowrap;
  }

  /* 판정 전 · — */
  .mark[data-mark='none'] {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .value {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-strong);
    overflow-wrap: anywhere; /* 긴 값이 좁은 카드를 넘치지 않게 */
  }

  .note {
    margin: 4px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--divider);
    font-size: 13px;
    color: var(--text-body);
  }

  /* ───────── 휴대폰 (폭 < 768px) ─────────
   * 버튼 목록 대신 선택기를 보이고, 범례 상자는 결과 아래로 보낸다.
   * 목록 칸(aside)을 display: contents로 풀어 그 안의 목록 머리·범례가 .columns의 항목이 되게 하고,
   * 범례만 order로 맨 뒤에 둔다 (DOM은 한 벌). 숨은 쪽은 display: none이라 탭 순서·접근성 트리에서도 빠진다. */
  @media (max-width: 767px) {
    .wide-only {
      display: none;
    }

    .narrow-only {
      display: inline;
    }

    .columns {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .models {
      display: contents;
    }

    .list {
      gap: 8px;
    }

    .list-head h2,
    .model-list {
      display: none;
    }

    .list-head label,
    .model-select {
      display: block;
    }

    .result {
      flex: none;
    }

    .legend {
      order: 1;
      margin-top: 0;
    }
  }
</style>
