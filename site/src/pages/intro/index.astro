---
import { fillCount } from '@opb/core';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { INCLUSION, INTRO_CARDS, INTRO_TAB, introChips, pageTitle } from '../../lib/copy.ts';
import { loadSiteData } from '../../lib/data.ts';
import { withBase } from '../../lib/paths.ts';

// 소개 탭 (docs/UI_GUIDE.md "소개 탭"). 모델 수는 models.json에서 온 값만 쓴다({N} → fillCount).
// 점수·순위·트로피, 숫자 카운트업·스크롤 애니메이션은 넣지 않는다 (UI_GUIDE 안티패턴)
const { models } = await loadSiteData();
const modelCount = models.length;

const ACTIONS = [
  { key: 'results', href: withBase(''), primary: true },
  { key: 'compare', href: withBase('compare/'), primary: false },
  { key: 'prompt', href: withBase('prompt/'), primary: false },
] as const;
---

<SiteLayout title={pageTitle(INTRO_TAB.name)} current="intro">
  <div class="page">
    <section class="hero">
      <p class="eyebrow" data-field="eyebrow">{INTRO_TAB.label}</p>
      <h1>{INTRO_TAB.title}</h1>
      <p class="lead" data-field="lead">{INTRO_TAB.description}</p>
      <div class="actions" data-field="actions">
        {
          ACTIONS.map((a) => (
            <a href={a.href} class:list={['button', { primary: a.primary }]} data-link={a.key}>
              {INTRO_TAB.actions[a.key]}
            </a>
          ))
        }
      </div>
      <ul class="chips" data-field="chips">
        {introChips(modelCount).map((chip) => <li>{chip}</li>)}
      </ul>
    </section>

    <div class="cards" data-field="cards">
      {
        INTRO_CARDS.map((card) => (
          <section class="card" data-card={card.key}>
            <p class="eyebrow">{card.label}</p>
            <h2>{card.title}</h2>
            <p>{fillCount(card.body, modelCount)}</p>
          </section>
        ))
      }
    </div>

    <section class="inclusion" data-field="inclusion">
      <div class="inclusion-text">
        <h2>{INCLUSION.title}</h2>
        <p>{INCLUSION.description}</p>
      </div>
      <div class="excluded">
        <h3>{INCLUSION.excludedTitle}</h3>
        <ul data-field="excluded">
          {
            INCLUSION.excluded.map((m) => (
              <li>
                <span class="name">{m.name}</span>
                <span class="reason">{m.reason}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  p,
  h1,
  h2,
  h3,
  ul {
    margin: 0;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  /* 작은 라벨: AI 모델 결과물 비교 · What · How · Caution */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  /* ───────── 히어로 ───────── */

  .hero {
    max-width: 760px;
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: 44px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .lead {
    font-size: 17px;
    color: var(--text-strong);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  /* 큰 버튼: 주 버튼은 --accent 바탕, 보조는 흰 바탕 + --border-strong */
  .button {
    display: inline-flex;
    align-items: center;
    padding: 12px 20px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-box);
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--accent-hover);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
  }

  .button.primary:hover {
    border-color: var(--accent-hover);
    background: var(--accent-hover);
    color: #ffffff;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-strong);
  }

  .chips li {
    padding: 4px 10px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
  }

  /* ───────── 카드 3개 ───────── */

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .card {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card .eyebrow {
    font-size: 12px;
  }

  h2 {
    font-size: 18px;
    font-weight: 600;
  }

  .card p:not(.eyebrow),
  .inclusion-text p {
    color: var(--text-body);
  }

  /* ───────── 수록 기준 ───────── */

  .inclusion {
    padding-top: 32px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .inclusion-text {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .excluded {
    flex: 2 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h3 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-strong);
  }

  .excluded ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .excluded li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-box);
    background: var(--surface);
  }

  .name {
    font-weight: 500;
  }

  .reason {
    color: var(--text-body);
  }
</style>
