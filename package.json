{
  "name": "one-prompt-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/core",
    "pipeline",
    "site"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w @opb/site",
    "dev": "npm run dev -w @opb/site",
    "check:results": "tsx packages/core/scripts/check-results.ts",
    "gen": "tsx --tsconfig pipeline/tsconfig.json pipeline/src/main.ts gen",
    "smoke": "tsx --tsconfig pipeline/tsconfig.json pipeline/src/main.ts smoke",
    "validate": "tsx --tsconfig pipeline/tsconfig.json pipeline/src/main.ts validate",
    "judge": "tsx --tsconfig pipeline/tsconfig.json pipeline/src/main.ts judge"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
